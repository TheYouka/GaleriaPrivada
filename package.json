{
  "name": "galeria",
  "version": "0.0.0",
  "private": true,
  "productName": "Galería",
  "description": "Galería privada de fotos y vídeos, cifrada y sin conexión",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "spike:native": "electron scripts/native-spike.cjs",
    "make:icon": "node scripts/make-icon.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "exifr": "7.1.3",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": false,
    "electron-winstaller": false
  }
}
